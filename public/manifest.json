{
  "manifest_version": 3,
  "name": "Luma New Tab",
  "version": "0.1.0",
  "description": "A calm, modular new-tab dashboard: clock, search, shortcuts, notes and tasks — stored on your device.",
  "offline_enabled": true,
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Luma New Tab"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
