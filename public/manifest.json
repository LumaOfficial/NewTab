{
  "manifest_version": 3,
  "name": "Luma New Tab",
  "short_name": "Luma",
  "version": "0.1.0",
  "description": "A calm, customizable new-tab dashboard with a clock, greeting, search, shortcuts, notes and tasks.",
  "minimum_chrome_version": "110",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
